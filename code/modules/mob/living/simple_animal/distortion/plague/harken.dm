/mob/living/simple_animal/hostile/distortion/harken/proc/fire_tangle(atom/target)
	if(tangle_cooldown > world.time)
		to_chat(src, span_warning("Tangle is on cooldown! ([round((tangle_cooldown - world.time) / 10, 0.1)]s remaining)"))
		return
	if(chained_target)
		to_chat(src, span_warning("You already have a target chained!"))
		return

	can_act = FALSE
	tangle_cooldown = world.time + tangle_cooldown_time

	// Generate noise on throw
	add_noise(tangle_noise_throw)

	face_atom(target)
	playsound(src, 'sound/distortions/the_adversary/swing.ogg', 75, TRUE)
	visible_message(span_danger("[src] prepares to hurl a light javelin!"))

	// Get line of turfs for warning tiles, stopping at walls
	var/turf/start_turf = get_turf(src)
	var/turf/target_turf = get_turf(target)
	var/list/turf/warning_turfs = list()

	if(start_turf && target_turf)
		var/list/turf/line_turfs = getline(start_turf, target_turf)
		for(var/turf/T in line_turfs)
			// Skip our own tile
			if(T == start_turf)
				continue
			// Stop at walls
			if(T.density)
				break
			warning_turfs += T
			// Create warning tile
			new /obj/effect/temp_visual/harken_warning(T)

	// 0.5 second windup delay
	sleep(5)

	if(QDELETED(src) || stat == DEAD)
		can_act = TRUE
		return

	visible_message(span_danger("[src] hurls a light javelin!"))

	// Fire projectile
	var/obj/projectile/harken_tangle/P = new(get_turf(src))
	P.owner_harken = src
	P.preparePixelProjectile(target, get_turf(src))
	P.fire()

	can_act = TRUE
	chosen_attack = 0

/// Called when tangle javelin hits a target
/mob/living/simple_animal/hostile/distortion/harken/proc/on_tangle_hit(atom/target)
	if(QDELETED(target))
		return
	if(chained_target)
		return

	var/mob/living/victim = null

	// Check if we hit a mech - extract pilot first
	if(istype(target, /obj/vehicle/sealed/mecha))
		var/obj/vehicle/sealed/mecha/mech = target
		victim = extract_pilot_from_mech(mech)
		if(!victim)
			return
	else if(isliving(target))
		var/mob/living/L = target
		if(L.stat == DEAD)
			return
		victim = L
	else
		return

	// Chain and yank the victim
	begin_chain_pull(victim)

/// Forcibly extracts pilot from mech and returns them
/mob/living/simple_animal/hostile/distortion/harken/proc/extract_pilot_from_mech(obj/vehicle/sealed/mecha/mech)
	if(!mech || !LAZYLEN(mech.occupants))
		return null

	var/mob/living/pilot = null
	for(var/mob/living/occupant in mech.occupants)
		if(ishuman(occupant))
			pilot = occupant
			break
		if(!pilot)
			pilot = occupant

	if(!pilot)
		return null

	visible_message(span_danger("[src] rips [pilot] out of [mech]!"))
	playsound(mech, 'sound/effects/meteorimpact.ogg', 50, TRUE)
	mech.mob_exit(pilot, FALSE, TRUE)

	return pilot

/// Chains target and performs one strong pull using throw_at()
/mob/living/simple_animal/hostile/distortion/harken/proc/begin_chain_pull(mob/living/victim)
	chained_target = victim

	// Generate noise on hit
	add_noise(tangle_noise_hit)

	// Both gain HP (percentage-based)
	var/harken_heal = maxHealth * tangle_heal_harken_percent
	var/target_heal = victim.maxHealth * tangle_heal_target_percent
	adjustBruteLoss(-harken_heal)
	victim.adjustBruteLoss(-target_heal)

	// Apply chained status effect
	victim.apply_status_effect(/datum/status_effect/harken_chained, src)

	// Create visual chain beam
	chain_beam = Beam(victim, icon_state = "chain", time = INFINITY, maxdistance = max_chain_distance + 5)

	visible_message(span_danger("[src] chains [victim] and yanks them close!"))
	playsound(src, 'sound/weapons/chainhit.ogg', 50, TRUE)

	// Calculate distance for the throw
	var/pull_distance = get_dist(src, victim)
	var/turf/my_turf = get_turf(src)

	// One strong pull - throw them directly at Harken
	victim.throw_at(
		target = my_turf,
		range = pull_distance,
		speed = tangle_throw_speed,
		thrower = src,
		spin = FALSE,
		gentle = TRUE
	)

/// Process chain state each Life() tick
/mob/living/simple_animal/hostile/distortion/harken/proc/process_chain()
	if(!chained_target)
		return

	// Check if target is too far
	if(get_dist(src, chained_target) > max_chain_distance)
		break_chain()
		return

	// Check if target is dead
	if(chained_target.stat == DEAD)
		break_chain()
		return

	// Check if we're stunned
	if(IsStun() || IsParalyzed() || HAS_TRAIT(src, TRAIT_KNOCKEDOUT))
		break_chain()
		return

/// Break the chain connection
/mob/living/simple_animal/hostile/distortion/harken/proc/break_chain()
	if(!chained_target)
		return

	visible_message(span_notice("The chain connecting [src] to [chained_target] shatters!"))
	playsound(src, 'sound/effects/glassbr1.ogg', 50, TRUE)

	// Generate noise on break
	add_noise(tangle_noise_break)

	// Remove status effect from target
	chained_target.remove_status_effect(/datum/status_effect/harken_chained)

	// Clean up beam
	if(chain_beam)
		QDEL_NULL(chain_beam)
	chained_target = null

