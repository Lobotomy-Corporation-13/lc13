//Harken - Die of Death Distortion
//A hunter that tracks prey by sound, featuring a noise meter system

// ===== MOVESPEED MODIFIERS =====

/datum/movespeed_modifier/harken_sprint
	variable = TRUE
	multiplicative_slowdown = -1.5  // Instant full sprint speed

/datum/movespeed_modifier/harken_immolate
	variable = TRUE
	multiplicative_slowdown = -1.0  // Speed boost while bleeding

/datum/movespeed_modifier/harken_enrage
	variable = TRUE
	multiplicative_slowdown = -1.0  // Speed boost while enraged

// ===== MAIN MOB DEFINITION =====

/mob/living/simple_animal/hostile/distortion/harken
	name = "Harken"
	desc = "A giant mechanical-looking yellow construct with long limbs."
	// PLACEHOLDER: Using adversary icons until custom sprites are made
	icon = 'ModularLobotomy/_Lobotomyicons/32x32.dmi'
	icon_state = "1x1x1x1"
	icon_living = "1x1x1x1"

	// Base stats
	maxHealth = 2000
	health = 2000

	// Damage resistances - weak to PALE
	damage_coeff = list(BRUTE = 1, RED_DAMAGE = 1, WHITE_DAMAGE = 1, BLACK_DAMAGE = 1, PALE_DAMAGE = 1.5)

	// Melee - Uses RED_DAMAGE (physical, fits impaling theme)
	melee_damage_lower = 50
	melee_damage_upper = 50
	melee_damage_type = RED_DAMAGE
	rapid_melee = 1
	move_to_delay = 4
	ranged = TRUE
	stat_attack = HARD_CRIT
	attack_verb_continuous = "impales"
	attack_verb_simple = "impale"
	attack_sound = 'sound/distortions/the_adversary/slashhit.ogg'
	del_on_death = TRUE
	can_patrol = TRUE
	robust_searching = TRUE
	ranged_ignores_vision = TRUE

	fear_level = WAW_LEVEL

	// Action types
	attack_action_types = list(
		/datum/action/innate/distortion_attack/harken_agitation,
		/datum/action/innate/distortion_attack/harken_tangle,
		/datum/action/innate/distortion_attack/harken_immolate,
		/datum/action/innate/distortion_attack/toggle/harken_sprint,
	)

	// ===== NOISE SYSTEM VARIABLES =====
	/// Current noise level
	var/noise = 0
	/// Maximum noise (calculated based on civilians)
	var/max_noise = 50
	/// Is Harken currently enraged?
	var/enraged = FALSE
	/// Rate at which noise drains while enraged (per Life() tick)
	var/noise_drain_rate = 2
	/// Has the UI been revealed to humans? (triggers at 50%)
	var/ui_revealed = FALSE
	/// List of humans who can see the noise UI
	var/list/ui_viewers = list()
	/// Harken's own noise meter HUD
	var/atom/movable/screen/harken_noise/harken_hud
	/// Dictionary of human -> their noise meter HUD
	var/list/human_huds = list()

	// ===== SPRINT SYSTEM VARIABLES =====
	/// Current stamina
	var/stamina = 100.0
	/// Maximum stamina
	var/max_stamina = 100.0
	/// Is currently sprinting?
	var/sprinting = FALSE
	/// Minimum stamina to start sprinting (15%)
	var/min_sprint_stamina = 15.0
	/// Stamina drained per Life() tick while sprinting
	var/sprint_stamina_drain = 5.0
	/// Stamina regenerated per Life() tick when not sprinting
	var/stamina_regen_rate = 5.0
	/// Timer for stamina updates
	var/stamina_update_timer
	/// Stamina bar image
	var/image/stamina_bar

	// ===== MELEE VARIABLES =====
	/// Melee cooldown tracker
	var/melee_cooldown = 0
	/// Melee cooldown time
	var/melee_cooldown_time = 1 SECONDS
	/// Melee windup time
	var/melee_windup = 0.15 SECONDS
	/// Noise generated on melee hit
	var/melee_noise = 2
	/// Enraged melee damage
	var/melee_damage_enraged = 80

	// ===== AGITATION VARIABLES =====
	/// Agitation cooldown tracker
	var/agitation_cooldown = 0
	/// Agitation cooldown time
	var/agitation_cooldown_time = 20 SECONDS
	/// Agitation damage
	var/agitation_damage = 15
	/// Noise generated by agitation
	var/agitation_noise = 5
	/// Minimum line length for agitation
	var/agitation_line_length = 8
	/// Delay between each beam (1 tick = 0.1 seconds)
	var/agitation_beam_delay = 1

	// ===== TANGLE VARIABLES =====
	/// Tangle cooldown tracker
	var/tangle_cooldown = 0
	/// Tangle cooldown time
	var/tangle_cooldown_time = 25 SECONDS
	/// Noise on throwing javelin
	var/tangle_noise_throw = 1
	/// Noise on hitting target
	var/tangle_noise_hit = 5
	/// Noise on chain breaking
	var/tangle_noise_break = 10
	/// Harken heals 10% of their max HP
	var/tangle_heal_harken_percent = 0.10
	/// Target heals 50% of their max HP
	var/tangle_heal_target_percent = 0.50
	/// Damage multiplier while target is chained
	var/tangle_damage_mult = 1.25
	/// Speed of the throw_at pull
	var/tangle_throw_speed = 4
	/// Currently chained target
	var/mob/living/chained_target = null
	/// Maximum chain distance before breaking
	var/max_chain_distance = 10
	/// Chain beam visual
	var/datum/beam/chain_beam = null

	// ===== IMMOLATE VARIABLES =====
	/// Immolate cooldown tracker
	var/immolate_cooldown = 0
	/// Immolate cooldown time
	var/immolate_cooldown_time = 35 SECONDS
	/// Self-damage as percentage of max HP
	var/immolate_self_damage_percent = 0.20
	/// DoT damage as percentage of max HP
	var/immolate_dot_percent = 0.05
	/// Duration of DoT
	var/immolate_dot_duration = 10 SECONDS
	/// Noise as percentage of max noise meter
	var/immolate_noise_percent = 0.60
	/// Is currently bleeding from immolate?
	var/immolate_bleeding = FALSE

	// ===== STATE CONTROL =====
	/// Can perform actions?
	var/can_act = TRUE

// ===== INITIALIZATION =====

/mob/living/simple_animal/hostile/distortion/harken/Initialize(mapload)
	. = ..()
	// Apply noise trackers to all humans
	apply_noise_trackers()
	// Register for new mob creation
	RegisterSignal(SSdcs, COMSIG_GLOB_MOB_CREATED, PROC_REF(on_mob_created))
	// Start stamina update timer (0.5 second intervals)
	stamina_update_timer = addtimer(CALLBACK(src, PROC_REF(process_stamina)), 0.5 SECONDS, TIMER_STOPPABLE | TIMER_LOOP)
	// Calculate initial max_noise based on civilians
	update_max_noise()
	// Setup noise meter HUD
	setup_harken_hud()

/mob/living/simple_animal/hostile/distortion/harken/Destroy()
	UnregisterSignal(SSdcs, COMSIG_GLOB_MOB_CREATED)
	remove_noise_trackers()
	remove_all_ui()
	deltimer(stamina_update_timer)
	remove_stamina_bar()
	if(chain_beam)
		QDEL_NULL(chain_beam)
	chained_target = null
	return ..()

/mob/living/simple_animal/hostile/distortion/harken/Login()
	. = ..()
	if(!. || !client)
		return FALSE
	to_chat(src, {"<h1>You are Harken, A Rhino Buster Distortion.</h1><br>
		<b>|ECHO LOCATION|: Your noise meter fills when you or nearby humans make noise.<br>
		- When full, you enter an ENRAGED state with increased speed and projectile immunity.<br>
		- While enraged, your melee attacks pierce through mechs to damage pilots.<br>
		<br>
		|SPRINT|: Toggle sprint for instant speed boost.<br>
		- Drains stamina while active<br>
		- Requires at least 15% stamina to activate<br>
		<br>
		|AGITATION|: Click a turf to create a line of disruptive energy.<br>
		- Knocks targets into the air<br>
		- Deals 15 RED damage<br>
		- 20 second cooldown<br>
		<br>
		|TANGLE|: Throw a javelin to chain and yank a target toward you.<br>
		- Heals you for 10% of your max HP<br>
		- Heals target for 50% of their max HP<br>
		- Chained targets take 1.25x damage from your attacks<br>
		- Pulls pilots out of mechs<br>
		- 25 second cooldown<br>
		<br>
		|IMMOLATE|: Impale yourself for power.<br>
		- Deals 20% of your max HP as immediate damage<br>
		- Deals 5% of your max HP over 10 seconds<br>
		- Generates 60% of your max noise meter<br>
		- Grants speed boost while bleeding<br>
		- Cannot be used while enraged<br>
		- 35 second cooldown<br>
		<br>
		Hunt by sound!</b>"})
	update_stamina_bar()
	// Re-add HUD when player logs in
	if(harken_hud)
		client.screen += harken_hud
	update_all_noise_ui()

// ===== LIFE PROCESSING =====

/mob/living/simple_animal/hostile/distortion/harken/Life()
	. = ..()
	if(!.)
		return FALSE
	process_noise_drain()
	process_chain()
	check_ui_reveal()

// ===== NOISE SYSTEM =====

/// Add noise to the meter and check for enrage trigger
/mob/living/simple_animal/hostile/distortion/harken/proc/add_noise(amount)
	if(amount <= 0)
		return
	noise = min(noise + amount, max_noise)
	update_all_noise_ui()
	check_enrage()

/// Check if should enter or exit enrage state
/mob/living/simple_animal/hostile/distortion/harken/proc/check_enrage()
	if(!enraged && noise >= max_noise)
		enter_enrage()
	else if(enraged && noise <= 10)
		exit_enrage()

/// Enter enraged state
/mob/living/simple_animal/hostile/distortion/harken/proc/enter_enrage()
	if(enraged)
		return
	enraged = TRUE
	visible_message(span_danger("[src] becomes enraged, moving with terrifying speed!"))
	playsound(src, 'sound/distortions/the_adversary/massinfection.ogg', 75, TRUE)
	// Apply speed boost
	add_movespeed_modifier(/datum/movespeed_modifier/harken_enrage)
	// End immolate bleed if active (enrage overrides it)
	if(immolate_bleeding)
		end_immolate_bleed()
	update_all_noise_ui()

/// Exit enraged state
/mob/living/simple_animal/hostile/distortion/harken/proc/exit_enrage()
	if(!enraged)
		return
	enraged = FALSE
	visible_message(span_notice("[src] calms down, the frenzy subsiding."))
	// Remove speed boost
	remove_movespeed_modifier(/datum/movespeed_modifier/harken_enrage)
	update_all_noise_ui()

/// Process noise drain while enraged (called in Life())
/mob/living/simple_animal/hostile/distortion/harken/proc/process_noise_drain()
	if(!enraged)
		return
	noise = max(0, noise - noise_drain_rate)
	update_all_noise_ui()
	check_enrage()

/// Update max_noise based on living civilians on the same z-level
/mob/living/simple_animal/hostile/distortion/harken/proc/update_max_noise()
	var/civilian_count = 0
	for(var/mob/living/carbon/human/H in GLOB.alive_mob_list)
		if(H.z == z && H.stat != DEAD)
			civilian_count++
	max_noise = max(50, civilian_count * 5)  // Minimum 50, scales with civilians
	update_all_noise_ui()

// ===== ENRAGE COMBAT BONUSES =====

/// Projectile immunity while enraged
/mob/living/simple_animal/hostile/distortion/harken/bullet_act(obj/projectile/P)
	if(enraged)
		visible_message(span_warning("[P] dissipates harmlessly against [src]'s frenzied aura!"))
		playsound(src, 'sound/effects/attackblob.ogg', 50, TRUE)
		return BULLET_ACT_BLOCK
	return ..()

/// Deal damage to pilots inside mechs while enraged
/mob/living/simple_animal/hostile/distortion/harken/proc/deal_mech_piercing_damage(obj/vehicle/sealed/mecha/mech, damage)
	if(!enraged)
		return
	if(!istype(mech))
		return
	if(!LAZYLEN(mech.occupants))
		return
	// Deal 50% of attack damage to all occupants
	for(var/mob/living/occupant in mech.occupants)
		occupant.deal_damage(damage * 0.5, melee_damage_type, src)
		to_chat(occupant, span_userdanger("[src]'s attack pierces through [mech] and strikes you!"))
	visible_message(span_danger("[src]'s frenzied attack pierces through [mech]'s armor!"))

// ===== MELEE ATTACK =====

/mob/living/simple_animal/hostile/distortion/harken/AttackingTarget(atom/attacked_target)
	if(!can_act)
		return FALSE
	if(melee_cooldown > world.time)
		return FALSE

	// Set cooldown
	melee_cooldown = world.time + melee_cooldown_time

	// Windup
	playsound(src, 'sound/distortions/the_adversary/swing.ogg', 75, TRUE)
	sleep(melee_windup)

	if(QDELETED(src) || QDELETED(attacked_target))
		return FALSE

	// Calculate damage (higher when enraged)
	var/damage = enraged ? melee_damage_enraged : rand(melee_damage_lower, melee_damage_upper)

	// Check if target is chained for bonus damage
	if(chained_target && attacked_target == chained_target)
		damage *= tangle_damage_mult

	// Deal damage
	if(isliving(attacked_target))
		var/mob/living/L = attacked_target
		do_attack_animation(L, ATTACK_EFFECT_SLASH)
		playsound(L, attack_sound, 75, TRUE)
		L.deal_damage(damage, melee_damage_type, src, attack_type = ATTACK_TYPE_MELEE)
		add_noise(melee_noise)

	// Mech-piercing when enraged
	if(istype(attacked_target, /obj/vehicle/sealed/mecha))
		var/obj/vehicle/sealed/mecha/mech = attacked_target
		do_attack_animation(mech, ATTACK_EFFECT_SLASH)
		playsound(mech, attack_sound, 75, TRUE)
		mech.take_damage(damage, melee_damage_type, MELEE, 1)
		deal_mech_piercing_damage(mech, damage)
		add_noise(melee_noise)

	return TRUE

/mob/living/simple_animal/hostile/distortion/harken/Move()
	if(!can_act)
		return FALSE
	return ..()

// ===== SPRINT SYSTEM =====

/mob/living/simple_animal/hostile/distortion/harken/proc/start_sprint()
	if(sprinting)
		return
	if(stamina < min_sprint_stamina)
		to_chat(src, span_warning("Not enough stamina to sprint! Need at least [min_sprint_stamina]%."))
		return
	sprinting = TRUE
	add_movespeed_modifier(/datum/movespeed_modifier/harken_sprint)
	to_chat(src, span_nicegreen("You begin sprinting!"))

/mob/living/simple_animal/hostile/distortion/harken/proc/stop_sprint()
	if(!sprinting)
		return
	sprinting = FALSE
	remove_movespeed_modifier(/datum/movespeed_modifier/harken_sprint)
	to_chat(src, span_warning("You stop sprinting."))

/mob/living/simple_animal/hostile/distortion/harken/proc/process_stamina()
	if(QDELETED(src))
		return
	if(sprinting)
		stamina -= sprint_stamina_drain
		stamina = max(0, stamina)
		if(stamina <= 0)
			to_chat(src, span_warning("You've run out of stamina!"))
			stop_sprint()
	else
		stamina += stamina_regen_rate
		stamina = min(max_stamina, stamina)
	update_stamina_bar()

/mob/living/simple_animal/hostile/distortion/harken/proc/update_stamina_bar()
	if(!client)
		return
	if(stamina >= max_stamina)
		remove_stamina_bar()
		return
	if(!stamina_bar)
		create_stamina_bar()
	var/bar_percent = round(stamina, 5)
	stamina_bar.icon_state = "prog_bar_[bar_percent]"

/mob/living/simple_animal/hostile/distortion/harken/proc/create_stamina_bar()
	if(!client)
		return
	stamina_bar = image('icons/effects/progessbar.dmi', src, "prog_bar_100", HUD_LAYER)
	stamina_bar.plane = ABOVE_HUD_PLANE
	stamina_bar.appearance_flags = APPEARANCE_UI_IGNORE_ALPHA
	stamina_bar.pixel_y = 32
	client.images += stamina_bar

/mob/living/simple_animal/hostile/distortion/harken/proc/remove_stamina_bar()
	if(!stamina_bar)
		return
	if(client)
		client.images -= stamina_bar
	stamina_bar = null

// ===== PLAYER NOISE TRACKING COMPONENT =====

/datum/component/harken_noise_tracker
	dupe_mode = COMPONENT_DUPE_UNIQUE
	/// Reference to the Harken that added this component
	var/mob/living/simple_animal/hostile/distortion/harken/owner_harken
	/// Range within which noise is reported to Harken
	var/noise_range = 15
	/// Noise values for different actions
	var/throw_noise = 3
	var/melee_attack_noise = 2
	var/ranged_fire_noise = 4
	/// Cooldown time between noise reports (2 seconds)
	var/noise_cooldown_time = 2 SECONDS
	/// Last time noise was reported
	var/last_noise_time = 0

/datum/component/harken_noise_tracker/Initialize(mob/living/simple_animal/hostile/distortion/harken/harken)
	. = ..()
	if(!ishuman(parent))
		return COMPONENT_INCOMPATIBLE
	owner_harken = harken

/datum/component/harken_noise_tracker/RegisterWithParent()
	RegisterSignal(parent, COMSIG_MOB_THROW, PROC_REF(on_throw))
	RegisterSignal(parent, COMSIG_MOB_ITEM_ATTACK, PROC_REF(on_melee_attack))
	RegisterSignal(parent, COMSIG_HUMAN_MELEE_UNARMED_ATTACK, PROC_REF(on_unarmed_attack))
	RegisterSignal(parent, COMSIG_MOB_FIRED_GUN, PROC_REF(on_ranged_fire))

/datum/component/harken_noise_tracker/UnregisterFromParent()
	UnregisterSignal(parent, list(
		COMSIG_MOB_THROW,
		COMSIG_MOB_ITEM_ATTACK,
		COMSIG_HUMAN_MELEE_UNARMED_ATTACK,
		COMSIG_MOB_FIRED_GUN
	))

/datum/component/harken_noise_tracker/proc/on_throw(datum/source, atom/target)
	SIGNAL_HANDLER
	report_noise(throw_noise)

/datum/component/harken_noise_tracker/proc/on_melee_attack(datum/source, mob/living/target, obj/item/weapon)
	SIGNAL_HANDLER
	report_noise(melee_attack_noise)

/datum/component/harken_noise_tracker/proc/on_unarmed_attack(datum/source, atom/target)
	SIGNAL_HANDLER
	report_noise(melee_attack_noise)

/datum/component/harken_noise_tracker/proc/on_ranged_fire(datum/source, obj/item/gun/gun, atom/target)
	SIGNAL_HANDLER
	report_noise(ranged_fire_noise)

/datum/component/harken_noise_tracker/proc/report_noise(amount)
	// Check cooldown
	if(world.time < last_noise_time + noise_cooldown_time)
		return
	last_noise_time = world.time

	var/mob/living/L = parent
	if(!istype(L))
		return
	// Find all Harken mobs in range and report noise to them
	for(var/mob/living/simple_animal/hostile/distortion/harken/H in range(noise_range, L))
		if(H.stat == DEAD)
			continue
		if(H.z != L.z)
			continue
		H.add_noise(amount)

// ===== HARKEN NOISE TRACKER MANAGEMENT =====

/mob/living/simple_animal/hostile/distortion/harken/proc/apply_noise_trackers()
	for(var/mob/living/carbon/human/H in GLOB.alive_mob_list)
		if(H.z != z)
			continue
		if(H.stat == DEAD)
			continue
		H.AddComponent(/datum/component/harken_noise_tracker, src)

/mob/living/simple_animal/hostile/distortion/harken/proc/on_mob_created(datum/source, mob/created_mob)
	SIGNAL_HANDLER
	if(!ishuman(created_mob))
		return
	var/mob/living/carbon/human/H = created_mob
	INVOKE_ASYNC(src, PROC_REF(try_add_tracker_to_new_mob), H)

/mob/living/simple_animal/hostile/distortion/harken/proc/try_add_tracker_to_new_mob(mob/living/carbon/human/H)
	sleep(5)
	if(QDELETED(H) || QDELETED(src))
		return
	if(H.z != z)
		return
	if(H.stat == DEAD)
		return
	var/datum/component/harken_noise_tracker/existing = H.GetComponent(/datum/component/harken_noise_tracker)
	if(existing && existing.owner_harken == src)
		return
	H.AddComponent(/datum/component/harken_noise_tracker, src)

/mob/living/simple_animal/hostile/distortion/harken/proc/remove_noise_trackers()
	for(var/mob/living/carbon/human/H in GLOB.alive_mob_list)
		var/datum/component/harken_noise_tracker/tracker = H.GetComponent(/datum/component/harken_noise_tracker)
		if(tracker && tracker.owner_harken == src)
			qdel(tracker)

// ===== UI SYSTEM =====

// Screen object for the noise meter HUD
/atom/movable/screen/harken_noise
	name = "Noise Meter"
	icon = 'icons/hud/screen_harken.dmi'
	icon_state = "noisebar_calm_0"
	screen_loc = "CENTER,NORTH-1"
	pixel_x = -169  // Center the 199px wide icon (-99) plus 70px left shift
	mouse_opacity = MOUSE_OPACITY_TRANSPARENT
	layer = ABOVE_HUD_LAYER

	/// Weak reference to the harken this HUD belongs to
	var/datum/weakref/harken_ref
	/// Current displayed percentage
	var/current_percent = 0
	/// Current enraged state
	var/current_enraged = FALSE

/// Update the noise meter display
/atom/movable/screen/harken_noise/proc/update_display(noise, max_noise, enraged)
	// Calculate percentage rounded to nearest 5
	var/raw_percent = (noise / max_noise) * 100
	var/new_percent = clamp(round(raw_percent, 5), 0, 100)

	// Determine state prefix
	var/state_prefix = enraged ? "enraged" : "calm"

	// Only update if changed
	if(new_percent != current_percent || enraged != current_enraged)
		current_percent = new_percent
		current_enraged = enraged
		icon_state = "noisebar_[state_prefix]_[new_percent]"

/// Setup Harken's own noise meter HUD
/mob/living/simple_animal/hostile/distortion/harken/proc/setup_harken_hud()
	harken_hud = new()
	harken_hud.harken_ref = WEAKREF(src)
	if(client)
		client.screen += harken_hud
	update_all_noise_ui()

/mob/living/simple_animal/hostile/distortion/harken/proc/check_ui_reveal()
	if(ui_revealed)
		return
	var/noise_percent = (noise / max_noise) * 100
	if(noise_percent >= 50)
		ui_revealed = TRUE
		reveal_ui_to_humans()

/mob/living/simple_animal/hostile/distortion/harken/proc/reveal_ui_to_humans()
	for(var/mob/living/carbon/human/H in GLOB.alive_mob_list)
		if(H.z != z)
			continue
		add_ui_to_human(H)
	// Play alert sound
	for(var/mob/living/carbon/human/H in ui_viewers)
		to_chat(H, span_userdanger("You sense a rising tension in the air..."))

/mob/living/simple_animal/hostile/distortion/harken/proc/add_ui_to_human(mob/living/carbon/human/H)
	if(!H?.client)
		return
	if(H in ui_viewers)
		return
	ui_viewers += H
	// Create a noise meter HUD for this human
	var/atom/movable/screen/harken_noise/human_hud = new()
	human_hud.harken_ref = WEAKREF(src)
	human_huds[H] = human_hud
	H.client.screen += human_hud
	update_human_hud(H)

/mob/living/simple_animal/hostile/distortion/harken/proc/remove_all_ui()
	// Remove Harken's own HUD
	if(harken_hud && client)
		client.screen -= harken_hud
