// ===== IMMOLATE ABILITY =====

/mob/living/simple_animal/hostile/distortion/harken/proc/activate_immolate()
	if(immolate_cooldown > world.time)
		to_chat(src, span_warning("Immolate is on cooldown! ([round((immolate_cooldown - world.time) / 10, 0.1)]s remaining)"))
		return
	if(enraged)
		to_chat(src, span_warning("You cannot use Immolate while enraged!"))
		return
	if(immolate_bleeding)
		to_chat(src, span_warning("You are already bleeding!"))
		return

	can_act = FALSE
	immolate_cooldown = world.time + immolate_cooldown_time

	// Sound and visual
	playsound(src, 'sound/distortions/the_adversary/slashhit.ogg', 75, TRUE)
	visible_message(span_danger("[src] impales itself with a light javelin!"))

	// Calculate damage based on max HP
	var/immediate_damage = maxHealth * immolate_self_damage_percent
	var/total_dot_damage = maxHealth * immolate_dot_percent

	// Deal immediate self-damage
	adjustBruteLoss(immediate_damage)

	// Generate noise (60% of max noise meter)
	var/noise_amount = max_noise * immolate_noise_percent
	add_noise(noise_amount)

	// Start bleeding and speed boost
	immolate_bleeding = TRUE
	add_movespeed_modifier(/datum/movespeed_modifier/harken_immolate)

	// Start the DoT proc
	start_immolate_dot(total_dot_damage, immolate_dot_duration)

	can_act = TRUE
	chosen_attack = 0

/// Proc-based damage over time for Immolate
/mob/living/simple_animal/hostile/distortion/harken/proc/start_immolate_dot(total_damage, duration)
	set waitfor = FALSE

	var/tick_interval = 1 SECONDS
	var/num_ticks = duration / tick_interval
	var/damage_per_tick = total_damage / num_ticks

	for(var/i in 1 to num_ticks)
		if(QDELETED(src))
			return
		if(stat == DEAD)
			end_immolate_bleed()
			return
		if(!immolate_bleeding)  // Ended early (e.g., by enrage)
			return

		// Deal DoT damage
		adjustBruteLoss(damage_per_tick)

		// Visual bleed effect
		new /obj/effect/temp_visual/dir_setting/bloodsplatter(get_turf(src), pick(GLOB.alldirs))

		sleep(tick_interval)

	end_immolate_bleed()

/// End the immolate bleed effect
/mob/living/simple_animal/hostile/distortion/harken/proc/end_immolate_bleed()
	if(!immolate_bleeding)
		return
	immolate_bleeding = FALSE
	remove_movespeed_modifier(/datum/movespeed_modifier/harken_immolate)
	visible_message(span_notice("[src]'s bleeding stops."))

// ===== OPENFIRE HANDLER =====

/mob/living/simple_animal/hostile/distortion/harken/OpenFire(atom/A)
	if(!can_act)
		return

	switch(chosen_attack)
		if(1)  // Agitation
			fire_agitation(A)
			return
		if(2)  // Tangle
			fire_tangle(A)
			return
		if(3)  // Immolate
			activate_immolate()
			return

	return ..()

